# Go build artifacts
moonlight
moonlight.exe
/dist/
/build/

# Runtime
/runs/
.killed
.moonlight-state.json
*.log
/logs/*
!/logs/.gitkeep

# Private scenarios / baselines — see SECURITY: every tester's recorded
# data may contain internal URLs and credentials. Only the two public demos
# are explicitly tracked.
scenarios/*
!scenarios/.gitkeep
!scenarios/demo-basic.yaml
!scenarios/demo-ai.yaml
baselines/*
!baselines/.gitkeep

# Saved login state (cookies, session tokens) — never commit
auth-state/*
!auth-state/.gitkeep

# Editor / tooling
.vscode/
.idea/
.serena/
*.swp
.DS_Store
settings.json
